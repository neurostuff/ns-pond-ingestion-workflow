m/xml/common/dtd" colname="col6">+124</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col7">0.16</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col8">+100</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col9">2.5</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col10">+181</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col11">40</entry></row><row><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col1" role="rowhead">Septum</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col2">+394</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col3">0.63</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" nameend="col5" namest="col4" role="colgroup">nt</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col6">+495</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col7">0.16</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" nameend="col9" namest="col8" role="colgroup">nt</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col10">+404</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col11">2.5</entry></row><row><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col1" role="rowhead">Globus pallidus</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col2">+90</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col3">0.63</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" nameend="col5" namest="col4" role="colgroup">nt</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col6">+109</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col7">0.16</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" nameend="col9" namest="col8" role="colgroup">nt</entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col10"><bold>+1148</bold><cross-ref id="cf0240" refid="tf0030"><sup loc="post"><bold>d</bold></sup></cross-ref></entry><entry xmlns="http://www.elsevier.com/xml/common/dtd" colname="col11">2.5</entry></row></tbody></tgroup><ce:legend><ce:simple-para id="sp0255" view="all">ERK1/2 phosphorylation (pERK) and c-Fos expression were determined in brain regions from Sprague-Dawley rats treated with 5-HT<ce:inf loc="post">1A</ce:inf> receptor agonists. Compounds were administered i.p. 30 min before sacrifice. pERK was determined by ELISA and c-Fos expression was determined by qPCR. Maximal stimulation (E<ce:inf loc="post">max</ce:inf>) values are expressed as % of control levels determined in vehicle-treated animals. pERK increases in frontal cortex and hypothalamus, reflect activation of postsynaptic 5-HT<ce:inf loc="post">1A</ce:inf> receptor. pERK decreases in hippocampus reflect activation of 5-HT<ce:inf loc="post">1A</ce:inf> autoreceptors. The Frontal Cortex/Hippocampus Ratio (‘<ce:italic>FrCtx/Hippo Ratio’</ce:italic>) is calculated by dividing the MED in Frontal cortex by that in Hippocampus to give an indication of the preferential regional activity of the agonists. Data shown in bold indicate indicate distinguishing properties of the agonists (see Footnotes for details).</ce:simple-para><ce:simple-para id="sp0260" view="all">Data are compiled from (<ce:cross-ref id="cf0245" refid="bb0290">Buritova et al., 2007</ce:cross-ref>; <ce:cross-ref id="cf0250" refid="bb0280">Buritova et al., 2009</ce:cross-ref>; <ce:cross-ref id="cf0255" refid="bb1050">Newman-Tancredi et al., 2009</ce:cross-ref>). nt: not tested.</ce:simple-para></ce:legend><ce:table-footnote id="tf0015"><ce:label>a</ce:label><ce:note-para id="np0015" view="all">NLX-101 and (+)8-OH-DPAT were equipotent in Frontal cortex and hippocampus, whereas other compounds inhibited pERK more potently in hippocampus.</ce:note-para></ce:table-footnote><ce:table-footnote id="tf0020"><ce:label>b</ce:label><ce:note-para id="np0020" view="all">NLX-101 and (+)8-OH-DPAT were more potent for stimulation of C-fos expression in prefrontal cortex than in other brain regions.</ce:note-para></ce:table-footnote><ce:table-footnote id="tf0025"><ce:label>c</ce:label><ce:note-para id="np0025" view="all">F13714 elicited large stimulation of C-fos expression in dorsal raphe, whereas NLX-101 showed very little effect therein.</ce:note-para></ce:table-footnote><ce:table-footnote id="tf0030"><ce:label>d</ce:label><ce:note-para id="np0030" view="all">Buspirone elicited very large stimulation of c-Fos expression in globus pallidus.</ce:note-para></ce:table-footnote></ce:table>