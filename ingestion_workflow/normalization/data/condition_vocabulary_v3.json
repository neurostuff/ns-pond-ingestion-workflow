{
 "name": "ns-pond condition vocabulary",
 "version": "3.0.0",
 "status": "frozen: approved by James, 2026-11-20",
 "source": "guide c2 vocabulary v3 plus the review of 994 Claude-labelled tasks (2026-11-20)",
 "rules": [
  "Rest and fixation are a condition's `kind`, never an atom.",
  "Task identity is the task's `task` field, never an atom.",
  "Groups, scores, drugs and sessions are record structure, never condition atoms.",
  "A condition that differs from its siblings only on a factor differs only on that factor's axis.",
  "Use a vocabulary axis when one fits. Otherwise a local axis is allowed: a snake_case name for the dimension, not a synonym of a vocabulary axis, with snake_case values. A local axis is any axis missing from this file; it counts toward contrast identity, and the vocabulary review clusters local axes into proposals.",
  "No `level` axis: a graded factor names its dimension.",
  "The absence of something is a value only on axes that list `absent` or `none`; otherwise it is the condition's kind (control_state or implicit_baseline)."
 ],
 "formats": {
  "case": "lower snake_case; no spaces, hyphens or symbols",
  "numeric": "`<number>_<unit>`, number first; a decimal point as `_` (`0_5_hz`); a negative as `minus_`",
  "units": [
   "ms",
   "s",
   "hz",
   "deg",
   "pct",
   "ma",
   "mmhg",
   "db",
   "items"
  ],
  "ordinal": "digits (`1`, `2`) or `block_<n>`",
  "graded": "low, medium, high on graded axes",
  "one_value": "one value per axis per condition, never a list; only `stimulus` may repeat on a condition"
 },
 "structural": {
  "task": "the task's own `task` field (inventory id)",
  "group": "between-subject groups, from the record's group cells (structure.py)",
  "score": "the covariate of a correlation or parametric contrast, from the record (structure.py)",
  "drug": "drug vs placebo, from the record's arms and timepoints (structure.py)",
  "session": "separate scan sessions or visits, from the record's timepoints (structure.py)"
 },
